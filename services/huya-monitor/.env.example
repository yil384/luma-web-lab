# Default: true collection attempts (not mocked). View README for limitations.
DEMO_MODE=0
HUYA_CHAT_ENABLED=1
# Experimental topic group subscription; switch to legacy only for protocol troubleshooting.
HUYA_CHAT_PROTOCOL=topic
POLL_SECONDS=45
# Set a strong randomly generated token only when integrating a permitted event source.
INGEST_TOKEN=

# Only enable CORS for your own public dashboard origin
CORS_ORIGINS=https://tanchensiyi.com
